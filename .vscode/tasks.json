{
    "tasks": [
        {
            "label": "prepare build directory",
            "type": "shell",
            "command": "mkdir",
            "args": ["-p", "${workspaceFolder}/build"],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-std=c++23",
                "-g",
                "-pedantic-errors",
                "-Wall",
                "-Weffc++",
                "-Wextra",
                "-Wconversion",
                "-Wsign-conversion",
                "-Werror",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/source/*.cpp",
                "-o",
                "${workspaceFolder}/build/consequences"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "prepare build directory",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
